# ---------------------------------------------------------------
# Database — Amazon RDS for PostgreSQL in AWS, Docker Postgres locally
# ---------------------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL="postgresql://saint:saint@localhost:5432/saint"
# AWS RDS — note sslmode=require:
# DATABASE_URL="postgresql://saintadmin:CHANGE_ME@saint-db.abc123.us-east-1.rds.amazonaws.com:5432/saint?sslmode=require"

DB_POOL_MAX="10"

# ---------------------------------------------------------------
# AWS — leave keys unset on App Runner; the instance role supplies them
# ---------------------------------------------------------------
AWS_REGION="us-east-1"
# Local dev only (or use `aws configure` / SSO instead):
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# S3 bucket that archives uploaded W-9s. Leave blank to skip archiving.
S3_W9_BUCKET=""

# ---------------------------------------------------------------
# Market news provider:  mock | newsapi | rss
# ---------------------------------------------------------------
NEWS_PROVIDER="mock"
NEWS_API_KEY=""
# For NEWS_PROVIDER=rss, {query} is replaced with the URL-encoded company name:
NEWS_RSS_TEMPLATE="https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en"

# ---------------------------------------------------------------
# Alerting (Amazon SES). Leave ALERT_FROM_EMAIL blank to log instead of send.
# ---------------------------------------------------------------
ALERT_FROM_EMAIL=""
DEFAULT_PROCUREMENT_MANAGER_EMAIL=""

# Shared secret for the scheduled batch news refresh endpoint
CRON_SECRET=""

NODE_ENV="development"
